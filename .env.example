# Copy to .env or export directly. Echelon reads these automatically (env wins over config.json).
# NEVER commit a filled-in .env file.

# ECHELON_CONFIG=/home/user/.config/echelon/config.json
# ECHELON_INTERVAL=300

# Notifications
# ECHELON_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# ECHELON_TELEGRAM_BOT_TOKEN=123456:ABC...
# ECHELON_TELEGRAM_CHAT_ID=-100123...
# ECHELON_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# ECHELON_GENERIC_WEBHOOK=https://example.com/hook

# Git providers (private repos + higher rate limits + commit enrichment)
# GitHub and GitHub Enterprise use the same token (Bearer).
# ECHELON_GITHUB_TOKEN=ghp_...
# ECHELON_GITLAB_TOKEN=glpat-...
# ECHELON_GITEA_TOKEN=...
# ECHELON_BITBUCKET_USER=you
# ECHELON_BITBUCKET_APP_PASSWORD=...

# AI summaries
# ECHELON_OPENAI_KEY=sk-...
# ECHELON_OPENAI_MODEL=gpt-4o-mini
# ECHELON_GEMINI_KEY=AIza...
# ECHELON_GEMINI_MODEL=gemini-2.5-flash
# ECHELON_OLLAMA_ENDPOINT=http://localhost:11434
# ECHELON_OLLAMA_MODEL=llama3.1

# Email (SMTP)
# ECHELON_SMTP_HOST=smtp.example.com
# ECHELON_SMTP_PORT=587
# ECHELON_SMTP_USER=user
# ECHELON_SMTP_PASSWORD=secret
# ECHELON_EMAIL_FROM=echelon@example.com
# ECHELON_EMAIL_TO=you@example.com
